<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <!-- ======================================== -->
    <!-- FUNDO EM VÍDEO                          -->
    <!-- ======================================== -->

    <VideoView
        android:id="@+id/background_video"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />


    <!-- Overlay simples -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#44000000" />


    <!-- ======================================== -->
    <!-- MENU LATERAL                            -->
    <!-- ======================================== -->

    <LinearLayout
        android:layout_width="72dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#66000000">

        <ImageButton
            android:id="@+id/setting_button"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_menu_settings"
            android:contentDescription="Configurações" />

    </LinearLayout>


    <!-- ======================================== -->
    <!-- HOME                                    -->
    <!-- ======================================== -->

    <LinearLayout
        android:id="@+id/home_content"
        android:layout_width="360dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:translationY="48dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">


        <Button
            android:id="@+id/play_button"
            android:layout_width="220dp"
            android:layout_height="64dp"
            android:text="JOGAR"
            android:textSize="20sp" />


        <Space
            android:layout_width="1dp"
            android:layout_height="16dp" />


        <!-- Barra que alterna entre social e loading -->

        <FrameLayout
            android:layout_width="340dp"
            android:layout_height="52dp"
            android:background="#66000000">


            <!-- REDES SOCIAIS -->

            <LinearLayout
                android:id="@+id/social_bar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Discord"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="YouTube"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Instagram"
                    android:textColor="#FFFFFF" />

            </LinearLayout>


            <!-- CARREGAMENTO -->

            <LinearLayout
                android:id="@+id/loading_bar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Carregando..."
                    android:textColor="#FFFFFF" />

                <ProgressBar
                    android:id="@+id/launcher_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:indeterminate="true" />

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>


    <!-- ======================================== -->
    <!-- CONFIGURAÇÕES                           -->
    <!-- ======================================== -->

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container_fragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="72dp"
        android:visibility="gone" />


    <!-- ======================================== -->
    <!-- COMPONENTES INTERNOS INVISÍVEIS         -->
    <!-- ======================================== -->

    <com.kdt.mcgui.mcAccountSpinner
        android:id="@+id/account_spinner"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <com.kdt.mcgui.ProgressLayout
        android:id="@+id/progress_layout"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

</FrameLayout>