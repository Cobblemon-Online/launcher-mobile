<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/account_existing"
    android:layout_width="match_parent"
    android:layout_height="51dp"
    android:background="@drawable/bg_account_option">

    <ImageView
        android:id="@+id/account_existing_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="12dp"
        android:src="@drawable/ic_microsoft" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/account_existing_email"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:fontFamily="@font/minecraft_standard" />

        <ImageView
            android:id="@+id/account_existing_switch"
            android:layout_width="17dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:adjustViewBounds="true"
            android:src="@drawable/ic_change" />

    </LinearLayout>

    <ImageView
        android:id="@+id/account_existing_delete"
        android:layout_width="17dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="12dp"
        android:adjustViewBounds="true"
        android:src="@drawable/ic_trash" />

</FrameLayout>