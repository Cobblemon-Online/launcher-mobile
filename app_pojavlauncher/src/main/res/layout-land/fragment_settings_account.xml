<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:color/transparent">


        <!-- ============================================== -->
        <!-- CONTA                                           -->
        <!-- ============================================== -->

        <TextView
            android:id="@+id/account_section_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Conta"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:fontFamily="@font/minecraft_standard" />

        <TextView
            android:id="@+id/account_section_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gerencie suas contas"
            android:textColor="#8D8D8D"
            android:textSize="10sp"
            android:fontFamily="@font/minecraft_standard" />


        <!-- ============================================== -->
        <!-- CONTA ATUAL                                    -->
        <!-- ============================================== -->

        <FrameLayout
            android:id="@+id/account_current"
            android:layout_width="match_parent"
            android:layout_height="51dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_account_current">

            <!-- ÍCONE MICROSOFT -->

            <ImageView
                android:id="@+id/account_current_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="12dp"
                android:src="@drawable/ic_microsoft" />

            <!-- EMAIL -->

            <TextView
                android:id="@+id/account_current_email"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="48dp"
                android:gravity="center_vertical"
                android:text="CHAPOLASCOL...@GMAIL.COM"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:fontFamily="@font/minecraft_standard" />

        </FrameLayout>


        <!-- ============================================== -->
        <!-- TROCAR DE CONTA                                -->
        <!-- ============================================== -->

        <TextView
            android:id="@+id/account_switch_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Trocar de conta"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:fontFamily="@font/minecraft_standard" />


        <!-- ============================================== -->
        <!-- CONTA MICROSOFT JÁ ADICIONADA                  -->
        <!-- ============================================== -->

        <LinearLayout
            android:id="@+id/account_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/transparent" />


        <!-- ============================================== -->
        <!-- ADICIONAR MICROSOFT                            -->
        <!-- ============================================== -->

        <FrameLayout
            android:id="@+id/account_add_microsoft"
            android:layout_width="match_parent"
            android:layout_height="51dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_account_option">

            <ImageView
                android:id="@+id/account_add_microsoft_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="12dp"
                android:src="@drawable/ic_microsoft" />

            <TextView
                android:id="@+id/account_add_microsoft_title"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="48dp"
                android:gravity="center_vertical"
                android:text="MICROSOFT"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:fontFamily="@font/minecraft_standard" />

            <TextView
                android:id="@+id/account_add_microsoft_action"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:layout_marginEnd="12dp"
                android:gravity="center"
                android:text="+ ADICIONAR CONTA"
                android:textColor="#888888"
                android:textSize="8sp"
                android:fontFamily="@font/minecraft_standard" />

        </FrameLayout>


        <!-- ============================================== -->
        <!-- CONTA OFFLINE                                  -->
        <!-- ============================================== -->

        <FrameLayout
            android:id="@+id/account_add_offline"
            android:layout_width="match_parent"
            android:layout_height="51dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_account_option">

            <ImageView
                android:id="@+id/account_add_offline_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="12dp"
                android:src="@drawable/ic_pirate" />

            <TextView
                android:id="@+id/account_add_offline_title"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="48dp"
                android:gravity="center_vertical"
                android:text="CONTA OFFLINE"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:fontFamily="@font/minecraft_standard" />

            <TextView
                android:id="@+id/account_add_offline_action"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:layout_marginEnd="12dp"
                android:gravity="center"
                android:text="+ ADICIONAR CONTA"
                android:textColor="#888888"
                android:textSize="8sp"
                android:fontFamily="@font/minecraft_standard" />

        </FrameLayout>

    </LinearLayout>

</ScrollView>